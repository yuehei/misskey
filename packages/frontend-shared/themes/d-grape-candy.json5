		"fgHighlighted": "#f2edf5",
		"fgOnAccent": "#2e2936",
		"fgOnWhite": "#8d34c9",
		"divider": "#514958",
		"panelHighlight": "#403a49",
		"panelHeaderBg": "#3d3747",
		"popup": "#3d3747",
		"navBg": "#35303f",
		"navActive": "#c38de8",
		"link": "#74c6df",
		"hashtag": "#f0b383",
		"mention": "#c38de8",
		"mentionMe": "#c38de8",
		"renote": "#78caae",
		"love": "#e784a3",
		"badge": "#74c6df",
		"buttonBg": "#433d4d",
		"buttonHoverBg": "#514958",
		"buttonGradateA": "#c38de8",
		"buttonGradateB": "#df9be0",
		"success": "#98dcb5",
		"warn": "#ecc87a",
		"error": "#ff9eab",
		"infoBg": "#2b3b4c",
		"infoFg": "#c3d8e8",
		"infoWarnBg": "#42321c",
		"infoWarnFg": "#ffcd79",
		"shadow": "#100c194d",
		"header": ":alpha<0.9<@panel",
