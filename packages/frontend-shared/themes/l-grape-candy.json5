		"panelHeaderBg": "#fcfafb",
		"popup": "#fcfafb",
		"navBg": "#f6f2f5",
		"navActive": "#8d34c9",
		"link": "#21758e",
		"hashtag": "#a55423",
		"mention": "#8d34c9",
		"mentionMe": "#8d34c9",
		"renote": "#1c7c67",
		"love": "#be3554",
		"badge": "#21758e",
		"buttonBg": "#e9e3e8",
